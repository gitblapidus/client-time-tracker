generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  timeEntriesCreated TimeEntry[] @relation("TimeEntryCreatedBy")
  timeEntriesUpdated TimeEntry[] @relation("TimeEntryUpdatedBy")
}

model Client {
  id              String    @id @default(cuid())
  name            String    @unique
  financeEmail    String?
  executiveName   String?
  executiveEmail  String?
  spocName        String?
  spocEmail       String?
  currency        String    @default("USD")
  devRate         Float     @default(0)
  pmRate          Float     @default(0)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  projects        Project[]

  @@index([active])
  @@index([name])
}

model ProductionManager {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@index([name])
}

model Project {
  id                    String      @id @default(cuid())
  clientId              String
  client                Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name                  String
  type                  String
  monthlyHours           Float?
  maximumCarryoverHours  Float?
  openingCarryoverHours  Float?
  startYear              Int
  startMonth             Int
  estimatedDevHours      Float?
  currency               String?
  devRate                Float?
  estimatedPmHours       Float?
  pmRate                 Float?
  quotedHours            Float?
  quotedDevelopmentHours Float?
  quotedDeliveryLeadHours Float?
  quotedTechnicalLeadershipHours Float?
  productionManager      String?
  burnStatus            String      @default("Not Started")
  active                Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  timeEntries           TimeEntry[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([active])
  @@index([type])
  @@index([productionManager])
}

model IntegrationClient {
  id              String                @id @default(cuid())
  name            String                @unique
  executiveName   String?
  executiveEmail  String?
  executivePhone  String?
  spocName        String?
  spocEmail       String?
  spocPhone       String?
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  projects        IntegrationProject[]

  @@index([active])
  @@index([name])
}

model IntegrationProject {
  id                 String             @id @default(cuid())
  clientId           String
  client             IntegrationClient  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name               String
  productionManager  String?
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([clientId, name])
  @@index([clientId])
  @@index([active])
  @@index([productionManager])
}

model IntegrationInventory {
  id           String   @id @default(cuid())
  referenceId  String   @unique
  name         String
  description  String?
  mvp          Boolean  @default(false)
  type         String   @default("In Scope")
  direction    String
  mode         String
  format       String
  dataSource   String?
  dataTarget   String?
  responsible  String?
  pillar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  details      IntegrationDetails?

  @@index([name])
  @@index([mvp])
  @@index([type])
  @@index([direction])
  @@index([mode])
  @@index([format])
  @@index([responsible])
  @@index([pillar])
}

model IntegrationDetails {
  id                          String               @id @default(cuid())
  inventoryId                 String               @unique
  inventory                   IntegrationInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  overview                    String?
  assumptions                 Json                 @default("[]")
  source                      String?
  target                      String?
  interfaceType               String?
  interfaceFormat             String?
  dataDependencies            String?
  jobDependencies             String?
  frequency                   String?
  scheduledMechanism          String?
  performanceConsiderations   String?
  interfaceTimeoutValue       String?
  expectedDataVolume          String?
  solutionApproach            String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
}

model TimeEntry {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  month             Int
  year              Int
  hoursUsed         Float
  developmentHours  Float?
  pmHours           Float?
  deliveryLeadHours Float?
  technicalLeadershipHours Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String
  updatedById       String
  createdBy         User     @relation("TimeEntryCreatedBy", fields: [createdById], references: [id])
  updatedBy         User     @relation("TimeEntryUpdatedBy", fields: [updatedById], references: [id])

  @@unique([projectId, month, year])
  @@index([projectId])
  @@index([year, month])
}

model AppSettings {
  id                   String   @id @default("default")
  companyName          String   @default("DSS Partners")
  financeEmail         String?
  defaultMonthlyHours  Float    @default(40)
  fiscalYearStartMonth Int      @default(1)
  updatedAt            DateTime @updatedAt
}
